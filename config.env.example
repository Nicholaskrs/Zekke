# Database
DB_USER=root
DB_PASSWORD=
DB_NAME=zekke
DB_HOST=localhost
DB_PORT=3306
DB_DRIVER=mysql
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Authentication
JWT_SECRET="secret"
JWT_ISSUER="TEMPLATE"

# Internal Authentication
API_KEY="SECRETKEY123"

# Domain
HOST_DOMAIN="http://localhost:9000"
SERVER_PORT=":9000"

# Log database. 0=false, 1=true
LOG_TYPE=1

# AWS
STORAGE_REGION = "us-east-1"
STORAGE_BUCKET = ""
STORAGE_BASE_PATH = ""
STORAGE_BASE_URL = ""

# Open Telemetry
OTEL_TRACE_ENDPOINT = "localhost:4317"
OTEL_METRICS_ENABLED = TRUE